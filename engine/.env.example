# ═══════ AI Market Reasoning Engine — إعدادات البيئة ═══════
# انسخ هذا الملف إلى engine/.env ثم عدّل القيم.
# قاعدة §37.1: لا سرّ في الشيفرة أبدًا — كل الأسرار هنا أو في متغيرات البيئة.

# وضع التشغيل: dev (sandbox محلي) | target (خادم الهدف عبر compose)
ENGINE_ENV=dev

# ── PostgreSQL (embedded binaries على 5543 تفاديًا للتصادم) ──
# مسبوق ENGINE_ كي لا يتصادم مع DATABASE_URL العام للمنصة
ENGINE_DATABASE_URL=postgresql://engine:engine@127.0.0.1:5543/engine
POSTGRES_PORT=5543
POSTGRES_USER=engine
POSTGRES_PASSWORD=engine
POSTGRES_DB=engine

# ── NATS (JetStream) ──
NATS_URL=nats://127.0.0.1:4222
NATS_MONITOR_PORT=8222

# ── MinIO (الخام Parquet) ──
S3_ENDPOINT=127.0.0.1:9100
S3_ACCESS_KEY=engine
S3_SECRET_KEY=engine-secret-change-me
S3_BUCKET=engine-raw
S3_SECURE=false

# ── engine-api (FastAPI) ──
ENGINE_API_HOST=127.0.0.1
ENGINE_API_PORT=4001

# ── TradingView webhook (المرحلة 10) ──
TV_WEBHOOK_SECRET=change-me-before-any-real-use

# ── Binance USDⓈ-M Futures (D-02: المصدر المرجعي) ──
BINANCE_API_BASE=https://fapi.binance.com
BINANCE_VISION_BASE=https://data.binance.vision
# الأداة الافتراضية للتطوير (عقد دائمة مشفرة تعمل 24/7)
ENGINE_SYMBOL=BTCUSDT

# ── الأطر الزمنية (D-05: HTF/MTF/LTF افتراضي قابل للتغيير) ──
ENGINE_TIMEFRAME_HTF=1h
ENGINE_TIMEFRAME_MTF=15m
ENGINE_TIMEFRAME_LTF=1m
