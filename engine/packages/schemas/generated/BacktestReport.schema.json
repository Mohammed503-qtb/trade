{
  "$defs": {
    "BacktestIdentity": {
      "additionalProperties": false,
      "description": "هوية الإعادة التساعية (§26.2 حرفيًا) — «النتيجة الدقيقة قابلة\nللاستنساخ من هذه المعرّفات».\n\nالمعرّفات التسعة بالنص: backtest_id، data_snapshot_id، code_version،\nmodel_version، parameter_set_version، cost_model_version، random_seed،\nstart_time، end_time، instrument_set — تُختم uuid5 في\n``backtest.identity`` (نمط decision_id_for).",
      "properties": {
        "backtest_id": {
          "title": "Backtest Id",
          "type": "string"
        },
        "code_version": {
          "title": "Code Version",
          "type": "string"
        },
        "cost_model_version": {
          "title": "Cost Model Version",
          "type": "string"
        },
        "data_snapshot_id": {
          "title": "Data Snapshot Id",
          "type": "string"
        },
        "end_time": {
          "format": "date-time",
          "title": "End Time",
          "type": "string"
        },
        "instrument_set": {
          "items": {
            "type": "string"
          },
          "title": "Instrument Set",
          "type": "array"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "parameter_set_version": {
          "title": "Parameter Set Version",
          "type": "string"
        },
        "random_seed": {
          "minimum": 0,
          "title": "Random Seed",
          "type": "integer"
        },
        "start_time": {
          "format": "date-time",
          "title": "Start Time",
          "type": "string"
        }
      },
      "required": [
        "backtest_id",
        "data_snapshot_id",
        "code_version",
        "model_version",
        "parameter_set_version",
        "cost_model_version",
        "random_seed",
        "start_time",
        "end_time",
        "instrument_set"
      ],
      "title": "BacktestIdentity",
      "type": "object"
    },
    "BacktestMetrics": {
      "additionalProperties": false,
      "description": "مقاييس الإعادة الكاملة — توقع صافٍ وعامل ربح وتوزيع R وMFE/MAE.\n\nكل قيمة None معلنة تعني «لا قياس ممكن» (لا صفقات مُوسومة): غياب\nمعلن لا قيمة مختلقة — النمط نفسه في مقيّم الاستئصال (5a.3).",
      "properties": {
        "by_regime": {
          "items": {
            "$ref": "#/$defs/RegimeMetrics"
          },
          "title": "By Regime",
          "type": "array"
        },
        "label_counts": {
          "additionalProperties": {
            "minimum": 1,
            "type": "integer"
          },
          "title": "Label Counts",
          "type": "object"
        },
        "labeled_trades": {
          "minimum": 1,
          "title": "Labeled Trades",
          "type": "integer"
        },
        "mae_mean_r": {
          "minimum": 0.0,
          "title": "Mae Mean R",
          "type": "number"
        },
        "mfe_mean_r": {
          "minimum": 0.0,
          "title": "Mfe Mean R",
          "type": "number"
        },
        "net_expectancy_r": {
          "title": "Net Expectancy R",
          "type": "number"
        },
        "not_executable": {
          "minimum": 0,
          "title": "Not Executable",
          "type": "integer"
        },
        "open_at_data_end": {
          "minimum": 0,
          "title": "Open At Data End",
          "type": "integer"
        },
        "profit_factor": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Profit Factor"
        },
        "r_distribution": {
          "$ref": "#/$defs/RDistribution"
        },
        "total_gross_r": {
          "title": "Total Gross R",
          "type": "number"
        },
        "total_net_r": {
          "title": "Total Net R",
          "type": "number"
        },
        "win_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Win Rate",
          "type": "number"
        }
      },
      "required": [
        "labeled_trades",
        "open_at_data_end",
        "not_executable",
        "label_counts",
        "net_expectancy_r",
        "profit_factor",
        "win_rate",
        "total_gross_r",
        "total_net_r",
        "r_distribution",
        "mfe_mean_r",
        "mae_mean_r",
        "by_regime"
      ],
      "title": "BacktestMetrics",
      "type": "object"
    },
    "CostMode": {
      "description": "أنماط التكلفة الثلاثة (§25.1 حرفيًا).\n\n«A strategy cannot pass production gates based only on optimistic\ncosts» — REALISTIC وحده نمط القبول؛ OPTIMISTIC تشخيصي وSTRESS\nلفحص المتانة.",
      "enum": [
        "OPTIMISTIC",
        "REALISTIC",
        "STRESS"
      ],
      "title": "CostMode",
      "type": "string"
    },
    "Direction": {
      "description": "الاتجاه الاتجاهي المثالث — LONG/SHORT وFLAT للحياد الصريح.",
      "enum": [
        "LONG",
        "SHORT",
        "FLAT"
      ],
      "title": "Direction",
      "type": "string"
    },
    "ExitReason": {
      "description": "أسباب خروج التنفيذ المحاكى — ميكانيكا المحاكي لا دلالة الوسم.\n\nالزوج (ExitReason, صافي R) يترجم إلى LabelState عبر محرك الوسم §30؛\nالدلالة تُشتق، لا تخترع.",
      "enum": [
        "TARGET",
        "STOP",
        "TIMEOUT",
        "ENTRY_EXPIRY",
        "UNFILLED"
      ],
      "title": "ExitReason",
      "type": "string"
    },
    "IntrabarPolicy": {
      "description": "سياسة الترتيب داخل الشمعة عند غموض التسلسل الزمني (§30).\n\nCONSERVATIVE حصراً في MVP: العكس يُفحص أولاً دائماً (أسوأ حالة)؛\nHIGHER_RESOLUTION مؤجل موثق (يتطلب بيانات دون إطار التنفيذ — بعد\nMVP).",
      "enum": [
        "CONSERVATIVE",
        "HIGHER_RESOLUTION"
      ],
      "title": "IntrabarPolicy",
      "type": "string"
    },
    "LabelState": {
      "description": "حالات الوسم الخمس (§30 حرفيًا) — وسم السيناريو بعد انقضاء أفقه.\n\n«Each candidate scenario receives a label only after its defined\nevaluation horizon ends» — الوسم بعد الأفق لا قبله، وإذا لمس الهدف\nوالوقف معاً داخل شمعة لا يعرف ترتيبها الزمني وجب الترتيب المتحفظ\n(أو بيانات أعلى دقة) — «يجب ألا يختار المخرج المحابي لمجرد جمال\nالإعادة» أبداً.",
      "enum": [
        "TARGET_FIRST",
        "INVALIDATION_FIRST",
        "TIMEOUT_WITH_PROFIT",
        "TIMEOUT_WITH_LOSS",
        "NOT_EXECUTABLE"
      ],
      "title": "LabelState",
      "type": "string"
    },
    "RDistribution": {
      "additionalProperties": false,
      "description": "توزيع R الصافية — إحصاءات رتبية حتمية (استيفاء خطي).",
      "properties": {
        "max_r": {
          "title": "Max R",
          "type": "number"
        },
        "mean_r": {
          "title": "Mean R",
          "type": "number"
        },
        "min_r": {
          "title": "Min R",
          "type": "number"
        },
        "p05_r": {
          "title": "P05 R",
          "type": "number"
        },
        "p50_r": {
          "title": "P50 R",
          "type": "number"
        },
        "p95_r": {
          "title": "P95 R",
          "type": "number"
        },
        "std_r": {
          "minimum": 0.0,
          "title": "Std R",
          "type": "number"
        }
      },
      "required": [
        "mean_r",
        "std_r",
        "min_r",
        "p05_r",
        "p50_r",
        "p95_r",
        "max_r"
      ],
      "title": "RDistribution",
      "type": "object"
    },
    "RealizedCosts": {
      "additionalProperties": false,
      "description": "التحلل المحقق §25.2 على تعبئات وقعت — بوحدات السعر لكل وحدة أصل.\n\nالمكونات الخمسة كما في التقديري (risk.CostBreakdown) لكن هنا من\nالتعبئات الفعلية ذهابًا وإيابًا، والمتطابقة محقاة: الصافي المحقق =\nالحافة الإجمالية المحققة − مجموع المكونات.\n\n``funding_financing`` صفر موثق في MVP (سبوت بلا تمويل) و\n``other_execution_costs`` صفر موثق (الاختيار السلبي المحقق قياسه\nبعد MVP؛ التقديري يعيش في §23.5) — لا اختلاق قياس لم يقع.",
      "properties": {
        "commission": {
          "minimum": 0.0,
          "title": "Commission",
          "type": "number"
        },
        "cost_mode": {
          "$ref": "#/$defs/CostMode"
        },
        "funding_financing": {
          "minimum": 0.0,
          "title": "Funding Financing",
          "type": "number"
        },
        "gross_realized_edge": {
          "title": "Gross Realized Edge",
          "type": "number"
        },
        "net_realized_edge": {
          "title": "Net Realized Edge",
          "type": "number"
        },
        "other_execution_costs": {
          "minimum": 0.0,
          "title": "Other Execution Costs",
          "type": "number"
        },
        "slippage": {
          "minimum": 0.0,
          "title": "Slippage",
          "type": "number"
        },
        "spread": {
          "minimum": 0.0,
          "title": "Spread",
          "type": "number"
        }
      },
      "required": [
        "cost_mode",
        "gross_realized_edge",
        "spread",
        "commission",
        "slippage",
        "funding_financing",
        "other_execution_costs",
        "net_realized_edge"
      ],
      "title": "RealizedCosts",
      "type": "object"
    },
    "RegimeMetrics": {
      "additionalProperties": false,
      "description": "مقاييس نظام سوق واحد — «حسب النظام» (تقسيم أنظمة §43).",
      "properties": {
        "net_expectancy_r": {
          "title": "Net Expectancy R",
          "type": "number"
        },
        "profit_factor": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Profit Factor"
        },
        "regime": {
          "title": "Regime",
          "type": "string"
        },
        "total_net_r": {
          "title": "Total Net R",
          "type": "number"
        },
        "trades_count": {
          "minimum": 1,
          "title": "Trades Count",
          "type": "integer"
        },
        "win_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Win Rate",
          "type": "number"
        }
      },
      "required": [
        "regime",
        "trades_count",
        "net_expectancy_r",
        "profit_factor",
        "win_rate",
        "total_net_r"
      ],
      "title": "RegimeMetrics",
      "type": "object"
    },
    "SimulatedFill": {
      "additionalProperties": false,
      "description": "تعبئة واحدة في العالم المحاكى — سعرًا وكمية ولحظة وكمونًا.\n\nلحظة التعبئة بدقة إطار البيانات (إغلاق شمعة اللمس) والكمون مسجل\nللفحص §24.5 — لا ساعة داخلية.",
      "properties": {
        "fill_time": {
          "format": "date-time",
          "title": "Fill Time",
          "type": "string"
        },
        "latency_ms": {
          "minimum": 0.0,
          "title": "Latency Ms",
          "type": "number"
        },
        "price": {
          "exclusiveMinimum": 0.0,
          "title": "Price",
          "type": "number"
        },
        "quantity": {
          "exclusiveMinimum": 0.0,
          "title": "Quantity",
          "type": "number"
        }
      },
      "required": [
        "fill_time",
        "price",
        "quantity",
        "latency_ms"
      ],
      "title": "SimulatedFill",
      "type": "object"
    },
    "SimulatedTrade": {
      "additionalProperties": false,
      "description": "الصفقة المحاكاة الكاملة لنية أمر واحدة — حتمية بذاتها.\n\n«Partial fills modeled» (§26.1): الدخول تعبئات متعددة بنسبة إعدادية\nلكل شمعة لمس؛ المخرج تعبئة واحدة (المخرج الأول فقط في MVP —\nالتدريج §24.6 بعد MVP موثقًا).\n\n``exit_reason=None`` تعني أن الصفقة بقيت مفتوحة حتى نهاية البيانات —\n«الوسم بعد انقضاء الأفق حصرًا» (§30) فلا وسم لها ولا تُعد في\nالمقاييس؛ تُحصى في ملاحظات التقرير (انضباط موثق).",
      "properties": {
        "ambiguity_resolved_conservatively": {
          "title": "Ambiguity Resolved Conservatively",
          "type": "boolean"
        },
        "costs": {
          "anyOf": [
            {
              "$ref": "#/$defs/RealizedCosts"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision_id": {
          "title": "Decision Id",
          "type": "string"
        },
        "entry_fills": {
          "items": {
            "$ref": "#/$defs/SimulatedFill"
          },
          "title": "Entry Fills",
          "type": "array"
        },
        "exit_fill": {
          "anyOf": [
            {
              "$ref": "#/$defs/SimulatedFill"
            },
            {
              "type": "null"
            }
          ]
        },
        "exit_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExitReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "filled_quantity": {
          "minimum": 0.0,
          "title": "Filled Quantity",
          "type": "number"
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/LabelState"
            },
            {
              "type": "null"
            }
          ]
        },
        "mae_r": {
          "minimum": 0.0,
          "title": "Mae R",
          "type": "number"
        },
        "mfe_r": {
          "minimum": 0.0,
          "title": "Mfe R",
          "type": "number"
        },
        "planned_quantity": {
          "exclusiveMinimum": 0.0,
          "title": "Planned Quantity",
          "type": "number"
        },
        "regime": {
          "title": "Regime",
          "type": "string"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "side": {
          "$ref": "#/$defs/Direction"
        },
        "stop_distance": {
          "exclusiveMinimum": 0.0,
          "title": "Stop Distance",
          "type": "number"
        },
        "stop_price": {
          "exclusiveMinimum": 0.0,
          "title": "Stop Price",
          "type": "number"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "target_price": {
          "exclusiveMinimum": 0.0,
          "title": "Target Price",
          "type": "number"
        },
        "trade_intent_id": {
          "title": "Trade Intent Id",
          "type": "string"
        }
      },
      "required": [
        "trade_intent_id",
        "scenario_id",
        "decision_id",
        "symbol",
        "side",
        "planned_quantity",
        "filled_quantity",
        "entry_fills",
        "exit_fill",
        "exit_reason",
        "stop_price",
        "target_price",
        "ambiguity_resolved_conservatively",
        "mfe_r",
        "mae_r",
        "stop_distance",
        "costs",
        "label",
        "regime"
      ],
      "title": "SimulatedTrade",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "تقرير الإعادة الكامل — «إعادة كاملة آلية موثقة» (بوابة 9).\n\nالحتمية: نفس الهوية والمدخلات ⇒ نفس البايتات كلها ما عدا\n``created_at_utc`` (الاستثناء الموثق الوحيد — نمط AblationReport)؛\nبنّاء التقرير يقبل ساعة محقونة فتصبح الحتمية كاملة.\n\n``trades`` بترتيب حتمي (زمن أول تعبئة/قرار ثم معرف السيناريو) و\n``unresolved_open`` إحصاء الباقيات مفتوحات حتى نهاية البيانات.",
  "properties": {
    "config_fingerprint": {
      "title": "Config Fingerprint",
      "type": "string"
    },
    "cost_mode": {
      "$ref": "#/$defs/CostMode"
    },
    "created_at_utc": {
      "format": "date-time",
      "title": "Created At Utc",
      "type": "string"
    },
    "identity": {
      "$ref": "#/$defs/BacktestIdentity"
    },
    "intrabar_policy": {
      "$ref": "#/$defs/IntrabarPolicy"
    },
    "metrics": {
      "$ref": "#/$defs/BacktestMetrics"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "trades": {
      "items": {
        "$ref": "#/$defs/SimulatedTrade"
      },
      "title": "Trades",
      "type": "array"
    }
  },
  "required": [
    "identity",
    "cost_mode",
    "intrabar_policy",
    "config_fingerprint",
    "trades",
    "metrics",
    "notes",
    "created_at_utc"
  ],
  "title": "BacktestReport",
  "type": "object"
}
