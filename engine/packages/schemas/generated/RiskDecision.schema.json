{
  "$defs": {
    "CostBreakdown": {
      "additionalProperties": false,
      "description": "تحلل التكلفة (§25.2 حرفيًا) — «Post-trade P&L must be decomposed\ninto» والتحلل هنا التقديري قبلها بوحدات السعر لكل وحدة أصل، ذهابًا\nوإيابًا، بنمط تكلفة معلن (§25.1).\n\nالمتطابقة محقاة في النموذج: net_trading_edge = gross − مجموع\nالمكونات الخمسة — أي انحراف رفض صاخب لا تقريب صامت.",
      "properties": {
        "commission": {
          "minimum": 0.0,
          "title": "Commission",
          "type": "number"
        },
        "cost_mode": {
          "$ref": "#/$defs/CostMode"
        },
        "funding_financing": {
          "minimum": 0.0,
          "title": "Funding Financing",
          "type": "number"
        },
        "gross_price_edge": {
          "minimum": 0.0,
          "title": "Gross Price Edge",
          "type": "number"
        },
        "net_trading_edge": {
          "title": "Net Trading Edge",
          "type": "number"
        },
        "other_execution_costs": {
          "minimum": 0.0,
          "title": "Other Execution Costs",
          "type": "number"
        },
        "slippage": {
          "minimum": 0.0,
          "title": "Slippage",
          "type": "number"
        },
        "spread": {
          "minimum": 0.0,
          "title": "Spread",
          "type": "number"
        }
      },
      "required": [
        "cost_mode",
        "gross_price_edge",
        "spread",
        "commission",
        "slippage",
        "funding_financing",
        "other_execution_costs",
        "net_trading_edge"
      ],
      "title": "CostBreakdown",
      "type": "object"
    },
    "CostMode": {
      "description": "أنماط التكلفة الثلاثة (§25.1 حرفيًا).\n\n«A strategy cannot pass production gates based only on optimistic\ncosts» — REALISTIC وحده نمط القبول؛ OPTIMISTIC تشخيصي وSTRESS\nلفحص المتانة.",
      "enum": [
        "OPTIMISTIC",
        "REALISTIC",
        "STRESS"
      ],
      "title": "CostMode",
      "type": "string"
    },
    "Direction": {
      "description": "الاتجاه الاتجاهي المثالث — LONG/SHORT وFLAT للحياد الصريح.",
      "enum": [
        "LONG",
        "SHORT",
        "FLAT"
      ],
      "title": "Direction",
      "type": "string"
    },
    "ExplanationObject": {
      "additionalProperties": false,
      "description": "كائن التفسير (§2.8 حرفيًا) — يرافق كل نية تداول وكل رفض.\n\n«Every trade intent must have an explanation object containing: market\ncontext, liquidity map, structural state, supporting evidence, opposing\nevidence, trigger, invalidation, expected path, cost estimate, and\nreason for rejection when no trade is taken» — الحقول العشرة بالترتيب.\nالمرحلة 6 تبني الكائن من لقطة الدمج والسياق المتاح؛ الحقول التي\nتملؤها مراحل لاحقة تحمل نص التأجيل الصريح (لا فراغ صامت): تقدير\nالتكاليف §25.2 يُستكمل في المرحلة 8، والمشغل الحي في المرحلة 7.",
      "properties": {
        "cost_estimate": {
          "title": "Cost Estimate",
          "type": "string"
        },
        "expected_path": {
          "title": "Expected Path",
          "type": "string"
        },
        "invalidation": {
          "title": "Invalidation",
          "type": "string"
        },
        "liquidity_map": {
          "title": "Liquidity Map",
          "type": "string"
        },
        "market_context": {
          "title": "Market Context",
          "type": "string"
        },
        "opposing_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Opposing Evidence",
          "type": "array"
        },
        "rejection_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rejection Reason"
        },
        "structural_state": {
          "title": "Structural State",
          "type": "string"
        },
        "supporting_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Evidence",
          "type": "array"
        },
        "trigger": {
          "title": "Trigger",
          "type": "string"
        }
      },
      "required": [
        "market_context",
        "liquidity_map",
        "structural_state",
        "supporting_evidence",
        "opposing_evidence",
        "trigger",
        "invalidation",
        "expected_path",
        "cost_estimate"
      ],
      "title": "ExplanationObject",
      "type": "object"
    },
    "HardBlockReason": {
      "description": "أسباب الحجب الصلب الخمسة عشر (§22.1 حرفيًا — بترقيم الخطة).\n\nأي سبب منها يمنع دخولًا جديدًا مهما بدت الدرجة الاتجاهية جذابة (§2.4).\nالنص الإنجليزي الأصلي مثبت كتعليق فوق كل عضو.",
      "enum": [
        "DATA_UNRELIABLE",
        "INSTRUMENT_UNAVAILABLE",
        "VENUE_CONNECTION_UNHEALTHY",
        "SPREAD_EXCEEDS_BUDGET",
        "SLIPPAGE_EXCEEDS_BUDGET",
        "LATENCY_EXCEEDS_BUDGET",
        "RISK_LIMITS_REACHED",
        "STOP_NOT_RELIABLE",
        "BROKER_REJECTS_ORDER",
        "MACRO_EMBARGO_WINDOW",
        "SCENARIO_INVALIDATED",
        "ENTRY_TOO_LATE",
        "CONFLICTING_SCENARIO",
        "SCENARIO_ALREADY_CONSUMED",
        "KILL_SWITCH"
      ],
      "title": "HardBlockReason",
      "type": "string"
    },
    "NoTradeExplanation": {
      "additionalProperties": false,
      "description": "تفسير عدم التداول (§22.3 حرفيًا — الحقول الستة بأسماء الخطة).\n\n«Every rejection has: no_trade_code, severity, triggering_conditions,\noffsetting_evidence, whether_retry_is_allowed, retry_condition» —\nرفض بلا تفسير مكتمل مستحيل معماريًا: الشرط يفحص آليًا في البوابة.",
      "properties": {
        "no_trade_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/HardBlockReason"
            },
            {
              "$ref": "#/$defs/SoftSuppressionReason"
            }
          ],
          "title": "No Trade Code"
        },
        "offsetting_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Offsetting Evidence",
          "type": "array"
        },
        "retry_condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Retry Condition"
        },
        "severity": {
          "$ref": "#/$defs/NoTradeSeverity"
        },
        "triggering_conditions": {
          "title": "Triggering Conditions",
          "type": "string"
        },
        "whether_retry_is_allowed": {
          "title": "Whether Retry Is Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "no_trade_code",
        "severity",
        "triggering_conditions",
        "offsetting_evidence",
        "whether_retry_is_allowed",
        "retry_condition"
      ],
      "title": "NoTradeExplanation",
      "type": "object"
    },
    "NoTradeSeverity": {
      "description": "شدة سبب عدم التداول (§22.3 «severity») — صلب أو لين.\n\nالصلب (§22.1): أي حاجب يمنع الدخول منعًا قاطعًا مهما بدت الدرجة\nجذابة. اللين (§22.2): كتم موزون يُجمع مع نظائره قبل الحسم.",
      "enum": [
        "HARD",
        "SOFT"
      ],
      "title": "NoTradeSeverity",
      "type": "string"
    },
    "OrderIntent": {
      "additionalProperties": false,
      "description": "نية أمر (§24.1 حرفيًا) — مواصفة تنفيذ معتمدة لا تحليلًا فنيًا.\n\nmax_slippage بوحدات السعر، max_latency بالمللي ثانية، risk_budget\nهو المخاطرة النقدية المسموحة للنية (أساس §23.2).",
      "properties": {
        "client_order_id": {
          "title": "Client Order Id",
          "type": "string"
        },
        "entry_policy": {
          "$ref": "#/$defs/OrderPolicy"
        },
        "entry_zone": {
          "$ref": "#/$defs/PriceZone"
        },
        "expiry": {
          "format": "date-time",
          "title": "Expiry",
          "type": "string"
        },
        "max_latency": {
          "minimum": 0.0,
          "title": "Max Latency",
          "type": "number"
        },
        "max_slippage": {
          "minimum": 0.0,
          "title": "Max Slippage",
          "type": "number"
        },
        "risk_budget": {
          "exclusiveMinimum": 0.0,
          "title": "Risk Budget",
          "type": "number"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "side": {
          "$ref": "#/$defs/Direction"
        },
        "stop": {
          "exclusiveMinimum": 0.0,
          "title": "Stop",
          "type": "number"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/TargetZone"
          },
          "title": "Targets",
          "type": "array"
        },
        "trade_intent_id": {
          "title": "Trade Intent Id",
          "type": "string"
        }
      },
      "required": [
        "trade_intent_id",
        "scenario_id",
        "symbol",
        "side",
        "entry_policy",
        "entry_zone",
        "stop",
        "targets",
        "max_slippage",
        "max_latency",
        "expiry",
        "risk_budget",
        "client_order_id"
      ],
      "title": "OrderIntent",
      "type": "object"
    },
    "OrderPolicy": {
      "description": "سياسات التنفيذ الخمس (§24.2).\n\nالاستراتيجية تحدد السياسة المسموحة؛ محرك التنفيذ يختار أأمن تنفيذ\nصالح داخل تلك القيود.",
      "enum": [
        "MARKET_WITH_SLIPPAGE_GUARD",
        "LIMIT_AT_ZONE",
        "STAGED_LIMIT_MARKET",
        "REDUCE_ONLY_EXIT",
        "EMERGENCY_FLATTEN"
      ],
      "title": "OrderPolicy",
      "type": "string"
    },
    "PriceZone": {
      "additionalProperties": false,
      "description": "نطاق سعري [price_low, price_high] — تمثيل مناطق الدخول.",
      "properties": {
        "price_high": {
          "exclusiveMinimum": 0.0,
          "title": "Price High",
          "type": "number"
        },
        "price_low": {
          "exclusiveMinimum": 0.0,
          "title": "Price Low",
          "type": "number"
        }
      },
      "required": [
        "price_low",
        "price_high"
      ],
      "title": "PriceZone",
      "type": "object"
    },
    "RejectionBasis": {
      "description": "أسس رفض القرار الثلاثة — تصنيف سبب الرفض في كائن القرار.\n\n§22.1 و§22.2 يبقيان حرفيين في أكوادهما؛ رفض «الحافة الصافية\nغير كافية» (§23.5: «A setup can be rejected because the gross\ntarget is large but cost-adjusted edge is insufficient») أساس\nثالث مستقل لأنه قرار كمي بعد التحجيم والتكاليف لا حاجب حالة.",
      "enum": [
        "HARD_BLOCK",
        "SOFT_SUPPRESSED",
        "NET_EDGE_INSUFFICIENT"
      ],
      "title": "RejectionBasis",
      "type": "string"
    },
    "RewardRiskEstimate": {
      "additionalProperties": false,
      "description": "تقدير المكافأة/المخاطرة (§23.5 حرفيًا) — المكونات السبعة وR الصافية.\n\n«The engine computes: gross target distance; expected slippage;\ncommission/fee; spread cost; expected adverse selection; partial-\nfill risk; estimated net R» — و«A setup can be rejected because the\ngross target is large but cost-adjusted edge is insufficient»:\nالرفض قرار كمي على estimated_net_r مقابل الحد الأدنى الإعدادي.",
      "properties": {
        "breakdown": {
          "$ref": "#/$defs/CostBreakdown"
        },
        "commission_fee": {
          "minimum": 0.0,
          "title": "Commission Fee",
          "type": "number"
        },
        "cost_mode": {
          "$ref": "#/$defs/CostMode"
        },
        "entry_reference": {
          "exclusiveMinimum": 0.0,
          "title": "Entry Reference",
          "type": "number"
        },
        "estimated_net_r": {
          "title": "Estimated Net R",
          "type": "number"
        },
        "expected_adverse_selection": {
          "minimum": 0.0,
          "title": "Expected Adverse Selection",
          "type": "number"
        },
        "expected_slippage": {
          "minimum": 0.0,
          "title": "Expected Slippage",
          "type": "number"
        },
        "gross_r": {
          "minimum": 0.0,
          "title": "Gross R",
          "type": "number"
        },
        "gross_target_distance": {
          "minimum": 0.0,
          "title": "Gross Target Distance",
          "type": "number"
        },
        "partial_fill_risk": {
          "minimum": 0.0,
          "title": "Partial Fill Risk",
          "type": "number"
        },
        "spread_cost": {
          "minimum": 0.0,
          "title": "Spread Cost",
          "type": "number"
        },
        "stop_distance": {
          "exclusiveMinimum": 0.0,
          "title": "Stop Distance",
          "type": "number"
        },
        "target_level": {
          "exclusiveMinimum": 0.0,
          "title": "Target Level",
          "type": "number"
        }
      },
      "required": [
        "cost_mode",
        "target_level",
        "entry_reference",
        "stop_distance",
        "gross_target_distance",
        "expected_slippage",
        "commission_fee",
        "spread_cost",
        "expected_adverse_selection",
        "partial_fill_risk",
        "estimated_net_r",
        "gross_r",
        "breakdown"
      ],
      "title": "RewardRiskEstimate",
      "type": "object"
    },
    "SizingCapBasis": {
      "description": "أي السقوف المطلقة قيّدت الحجم (§23.2 «capped by absolute\nportfolio and instrument limits»).\n\nNONE: لم يقيّد سقف الحجم — المعدلات وحدها خفضته أو تركته.",
      "enum": [
        "NONE",
        "INSTRUMENT",
        "PORTFOLIO"
      ],
      "title": "SizingCapBasis",
      "type": "string"
    },
    "SizingModifier": {
      "additionalProperties": false,
      "description": "معدل تحجيم واحد — اسمه وقيمته وتوثيق سببه.\n\nالمعدل ∈ (0, 1]: لا معدل يرفع الحجم أبدًا — «الخطر الناتج ≤\nالسقف دائمًا» (بوابة الخروج 8) تُبنى على هذا الحصر.",
      "properties": {
        "multiplier": {
          "title": "Multiplier",
          "type": "number"
        },
        "name": {
          "$ref": "#/$defs/SizingModifierName"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "name",
        "multiplier",
        "rationale"
      ],
      "title": "SizingModifier",
      "type": "object"
    },
    "SizingModifierName": {
      "description": "معدلات التحجيم الستة (§23.2 حرفيًا بترتيب الخطة).\n\n«Then apply: volatility modifier; liquidity modifier; execution-\nquality modifier; correlation modifier; daily drawdown modifier;\nscenario quality modifier after calibration» — كل معدل يضرب الحجم\nالأساسي، ولا معدل يرفع الأحجام أبدًا (خاصية «الخطر الناتج ≤\nالسقف دائمًا» — بوابة الخروج 8).",
      "enum": [
        "VOLATILITY",
        "LIQUIDITY",
        "EXECUTION_QUALITY",
        "CORRELATION",
        "DAILY_DRAWDOWN",
        "SCENARIO_QUALITY"
      ],
      "title": "SizingModifierName",
      "type": "string"
    },
    "SizingResult": {
      "additionalProperties": false,
      "description": "نتيجة التحجيم الكاملة (§23.2) — الشفافية الرقمية لكل خطوة.\n\nالحساب الحرفي: ``position_size = allowed_risk_money /\nstop_distance_value`` ثم المعدلات الستة مضاعفةً ثم السقوف المطلقة\n(أداة ومحفظة) — و«resulting_risk_money = position_size ×\nstop_distance_value ≤ risk_budget دائمًا» شرط يُحقق في النموذج ذاته.",
      "properties": {
        "base_position_size": {
          "exclusiveMinimum": 0.0,
          "title": "Base Position Size",
          "type": "number"
        },
        "capped_by": {
          "$ref": "#/$defs/SizingCapBasis"
        },
        "final_multiplier": {
          "title": "Final Multiplier",
          "type": "number"
        },
        "instrument_cap": {
          "exclusiveMinimum": 0.0,
          "title": "Instrument Cap",
          "type": "number"
        },
        "modifiers": {
          "items": {
            "$ref": "#/$defs/SizingModifier"
          },
          "title": "Modifiers",
          "type": "array"
        },
        "portfolio_cap_remaining": {
          "exclusiveMinimum": 0.0,
          "title": "Portfolio Cap Remaining",
          "type": "number"
        },
        "position_size": {
          "exclusiveMinimum": 0.0,
          "title": "Position Size",
          "type": "number"
        },
        "resulting_risk_money": {
          "minimum": 0.0,
          "title": "Resulting Risk Money",
          "type": "number"
        },
        "risk_budget": {
          "exclusiveMinimum": 0.0,
          "title": "Risk Budget",
          "type": "number"
        },
        "stop_distance_value": {
          "exclusiveMinimum": 0.0,
          "title": "Stop Distance Value",
          "type": "number"
        }
      },
      "required": [
        "risk_budget",
        "stop_distance_value",
        "base_position_size",
        "modifiers",
        "final_multiplier",
        "instrument_cap",
        "portfolio_cap_remaining",
        "capped_by",
        "position_size",
        "resulting_risk_money"
      ],
      "title": "SizingResult",
      "type": "object"
    },
    "SoftSuppressionReason": {
      "description": "الكتمات اللينة العشر (§22.2 حرفيًا — بنص الخطة).\n\n«The system may also decline when: ...» — ليست رفضًا صلبًا بل كتمًا\nموزونًا (§8.2 بأوزان إعدادية): تُجمع أوزان المشتعلة منها وتُقارن\nبعتبة؛ تجاوزها يمنع الدخول بأسباب موثقة كالصلب (§22.3) لكن مع\nقابلية إعادة المحاولة دائمًا — الظرف يزول بزوال سببه.",
      "enum": [
        "POOR_LOCATION",
        "WEAK_OR_CORRELATED_EVIDENCE",
        "VOLATILITY_TOO_LOW",
        "VOLATILITY_TOO_EXTREME",
        "REGIME_TRANSITION",
        "TARGET_TOO_CLOSE",
        "STOP_TOO_WIDE",
        "SESSION_CONFLICT",
        "CHASING_EXPANDED_MOVE",
        "HORIZON_EXCEEDED"
      ],
      "title": "SoftSuppressionReason",
      "type": "string"
    },
    "StructuralStop": {
      "additionalProperties": false,
      "description": "حساب الوقف البنيوي (§23.4 حرفيًا) — «بنية + عازلة تقلب + عدم\nيقين تنفيذ» لا رقم نقاط كوني.\n\nمرجع الدخول المخطط (ADR-026): الحافة المحافظة لمنطقة الدخول — أبعد\nحافة عن الوقف — فتكون 1R المحسوبة أسوأ حالة للتعبئة (التحجيم لا\nيتفاءل بتعبة أفضل).",
      "properties": {
        "accept_through": {
          "title": "Accept Through",
          "type": "boolean"
        },
        "atr": {
          "exclusiveMinimum": 0.0,
          "title": "Atr",
          "type": "number"
        },
        "entry_reference": {
          "exclusiveMinimum": 0.0,
          "title": "Entry Reference",
          "type": "number"
        },
        "execution_uncertainty": {
          "minimum": 0.0,
          "title": "Execution Uncertainty",
          "type": "number"
        },
        "stop_distance": {
          "exclusiveMinimum": 0.0,
          "title": "Stop Distance",
          "type": "number"
        },
        "stop_distance_atr": {
          "exclusiveMinimum": 0.0,
          "title": "Stop Distance Atr",
          "type": "number"
        },
        "stop_price": {
          "exclusiveMinimum": 0.0,
          "title": "Stop Price",
          "type": "number"
        },
        "structural_level": {
          "exclusiveMinimum": 0.0,
          "title": "Structural Level",
          "type": "number"
        },
        "volatility_buffer": {
          "minimum": 0.0,
          "title": "Volatility Buffer",
          "type": "number"
        }
      },
      "required": [
        "structural_level",
        "volatility_buffer",
        "execution_uncertainty",
        "stop_price",
        "entry_reference",
        "stop_distance",
        "accept_through",
        "atr",
        "stop_distance_atr"
      ],
      "title": "StructuralStop",
      "type": "object"
    },
    "TargetZone": {
      "additionalProperties": false,
      "description": "هدف مرتبط بمنطقة سيولة (§10.5): مستوى سعر + مرجع المنطقة.",
      "properties": {
        "price_level": {
          "exclusiveMinimum": 0.0,
          "title": "Price Level",
          "type": "number"
        },
        "zone_id": {
          "title": "Zone Id",
          "type": "string"
        }
      },
      "required": [
        "price_level",
        "zone_id"
      ],
      "title": "TargetZone",
      "type": "object"
    }
  },
  "additionalProperties": false,
