      "type": "number"
    },
    "failed_extremes": {
      "minimum": 0,
      "title": "Failed Extremes",
      "type": "integer"
    },
    "follow_through": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Follow Through",
      "type": "number"
    },
    "instrument": {
