      "title": "Decay Ratio",
      "type": "number"
    },
    "direction": {
      "$ref": "#/$defs/FlowDirection"
    },
    "efficiency": {
      "exclusiveMinimum": 0.0,
      "title": "Efficiency",
      "type": "number"
    },
    "efficiency_prev": {
      "exclusiveMinimum": 0.0,
